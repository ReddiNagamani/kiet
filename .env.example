# Database Connection (SQLite default for instant local setup, or PostgreSQL: postgresql://user:password@localhost:5432/kiet_db)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret Key
AUTH_SECRET="your_secure_random_jwt_secret_key"

# OpenAI or compatible LLM API Key (Optional: system automatically uses built-in smart RAG synthesizer when empty)
OPENAI_API_KEY="sk-..."

# Razorpay Sandbox Credentials for Online Fee Payment (Test Mode)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret_..."

# Vector Database URL (Optional - defaults to SQLite Vector Table)
VECTOR_DATABASE_URL=""

# App URL & College Branding
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COLLEGE_NAME="KIET Group of Institutions, Kakinada"
